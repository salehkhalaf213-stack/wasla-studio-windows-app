{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QENTRIVO",
  "version": "1.1.3",
  "identifier": "com.waslastudio.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QENTRIVO | Workspace",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IEQ1RDFDMzBEMjAyNDA3QzQKUldURUJ5UWdEY1BSMVFiMDA4UXQ3bUN0eitBc0FKOER4WHhMRGxoa256QldMMjZjTENLWHBJUlIK",
      "endpoints": [
        "https://github.com/salehkhalaf213-stack/wasla-studio-windows-app/releases/download/preview-latest/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "QENTRIVO"
      }
    }
  }
